{
  "name": "@fluentic/shipkit-appicon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/plugin.js",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.server.json && vite build",
    "cf:build": "VITE_SHIPKIT_PROMO=true vite build --base /appicon/",
    "cf:deploy": "pnpm run cf:build && wrangler deploy",
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit"
  },
  "dependencies": {
    "@expo/config-plugins": "^58.0.10",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "19.3.1",
    "react-colorful": "^5.8.1",
    "react-dom": "19.3.1",
    "vite": "^8.3.5"
  },
  "peerDependencies": {
    "expo": "*"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "wrangler": "^4.152.0"
  }
}
