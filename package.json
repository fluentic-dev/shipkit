{
  "name": "@fluentic/shipkit-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build": "pnpm --filter @fluentic/shipkit build",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "dev": "pnpm --filter @fluentic/shipkit dev",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "lint": "oxlint .",
    "typecheck": "pnpm --filter @fluentic/shipkit typecheck && pnpm --filter @fluentic/shipkit-example-expo exec tsc --noEmit"
  },
  "devDependencies": {
    "dprint": "^0.63.0",
    "oxlint": "^1.87.0",
    "typescript": "^5.9.3"
  }
}
