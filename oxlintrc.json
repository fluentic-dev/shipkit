{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "env": {
    "node": true,
    "es2022": true
  },
  "ignorePatterns": [
    "node_modules",
    "dist",
    "target",
    "private",
    "examples/expo/.expo",
    "examples/expo/ios",
    "examples/expo/android"
  ],
  "rules": {
    "no-console": "off",
    "unicorn/prefer-node-protocol": "error"
  }
}
